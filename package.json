{
  "name": "understudy",
  "version": "0.1.0",
  "private": true,
  "description": "Record-once, replay-many computer use for legacy back-office apps. An LLM discovers how to complete a task in a UI with no API; the run is captured as a typed, versioned capability; replay runs deterministically with no model in the loop.",
  "type": "module",
  "bin": {
    "understudy": "./src/cli.ts"
  },
  "scripts": {
    "mock": "tsx mock-app/server.ts",
    "discover": "tsx src/cli.ts discover",
    "replay": "tsx src/cli.ts replay",
    "invoke": "tsx src/cli.ts invoke",
    "catalog": "tsx src/cli.ts catalog",
    "approve": "tsx src/cli.ts approve",
    "stability": "tsx src/cli.ts stability",
    "serve": "tsx src/cli.ts serve",
    "evidence": "tsx scripts/evidence.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "express": "^4.21.2",
    "playwright": "^1.49.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
