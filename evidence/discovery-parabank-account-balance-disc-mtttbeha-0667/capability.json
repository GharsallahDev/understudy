  "outputs": [
    {
      "name": "accountBalance",
      "type": "number",
      "description": "Extracted accountBalance",
      "extraction": {
        "target": {
          "description": "row \"13344\"",
          "strategies": [
            {
              "kind": "relative",
              "anchor": {
                "text": "13344",
                "exact": false,
                "fromInput": "accountId"
              },
              "relation": "parentRow",
              "target": {}
            }
          ],
          "confidence": 0.85,
          "robustnessNotes": "Row anchored on its stable label \"13344\"; the value it contains is read from the row text and is parameter-independent. Stabilized for extraction: input-specific names removed."
        },
        "attribute": "text",
        "transform": "currencyToCents",
        "pattern": "(\\$[\\d,]+\\.\\d{2})"
      }
    }
  ],
