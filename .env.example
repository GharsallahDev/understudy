# --- Discovery (LLM) — required ONLY for `npm run discover` -------------------
# Vertex AI Express Mode API key (starts with "AQ."). Replay never uses the model.
GEMINI_API_KEY=AQ.your-vertex-express-key
GOOGLE_GENAI_USE_VERTEXAI=true

# Discovery model (Gemini via Vertex). Bump to gemini-3.1-pro-preview for harder flows.
UNDERSTUDY_MODEL=gemini-3.5-flash

# --- Target surface ----------------------------------------------------------
TARGET_BASE_URL=http://localhost:3100

# --- Optional ----------------------------------------------------------------
# HEADLESS=1                 # run browsers headless (default: headed)
# OPERATOR_PORT=4600         # operator console port (human-in-the-loop)
# CATALOG_PORT=4700          # agent-facing catalog API port
# MOCK_USER=operator         # mock console credentials (never real creds)
# MOCK_PASS=demo-pass
